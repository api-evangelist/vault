                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
