          "name": "HashiCorp Vault Read Secret Metadata",
          "request": {
            "name": "HashiCorp Vault Read Secret Metadata",
            "description": {
              "content": "Retrieve metadata and version history for a secret at the given path. Returns all version timestamps, current version number, max versions setting, CAS required status, and custom metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "secret",
                "metadata",
                ":path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) Path to the secret in the KV v2 store. Use forward slashes to organize secrets in a hierarchy. Example: myapp/production/db."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
