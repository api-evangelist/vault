          "name": "HashiCorp Vault Enable Secrets Engine",
          "request": {
            "name": "HashiCorp Vault Enable Secrets Engine",
            "description": {
              "content": "Mount a new secrets engine at the specified path. Supported types include aws, azure, consul, database, gcp, kv, nomad, pki, rabbitmq, ssh, totp, transit, and more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sys",
                "mounts",
                ":path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
