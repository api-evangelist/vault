          "id": "08a537ca-5085-4e57-8e8f-21ee1c451ed9",
          "name": "HashiCorp Vault Write ACL Policy",
          "request": {
            "name": "HashiCorp Vault Write ACL Policy",
            "description": {
              "content": "Create or update an ACL policy. Policies are written in HashiCorp Configuration Language (HCL) and define path-based access rules with capabilities such as create, read, update, delete, list, and sudo.",
