        {
          "id": "3fbafe1a-fed5-4102-8495-10c107bff198",
          "name": "HashiCorp Vault Enable Auth Method",
          "request": {
            "name": "HashiCorp Vault Enable Auth Method",
            "description": {
              "content": "Enable a new auth method at the specified path. Requires sudo capability. Supported types include approle, aws, azure, github, jwt, kubernetes, ldap, oidc, okta, radius, token, and userpass.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sys",
                "auth",
                ":path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) Mount path for the auth method or secrets engine. Must not contain slashes at the beginning or end."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
